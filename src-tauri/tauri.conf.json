{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ch32-rs-cubemx",
  "version": "0.1.0",
  "identifier": "com.ch32rs.cubemx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ch32-rs-CubeMX · CH32 配置器",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "CH32 RISC-V 纯本地图形化配置器（Rust + ch32-hal）",
    "longDescription": "ch32-rs-CubeMX 是 STM32CubeMX 风格的 CH32 配置器：图形化配置引脚/时钟/外设，直接生成可 cargo build 的 Rust + ch32-hal 工程，全程本地运行、无云端依赖。",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}