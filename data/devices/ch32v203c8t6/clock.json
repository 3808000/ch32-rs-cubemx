        "bits": 4,
        "default": 3,
        "raw": true,
        "note": "CTLR3.CLK_DIV raw 语义待核实；HAL 缺省 0b11"
      }
    },
    "usb": {
      "autoPre": { "48": 1, "96": 2, "144": 3 },
