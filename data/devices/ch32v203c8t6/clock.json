      "fixedDivLabel": "÷1",
      "note": "RM 图 3-3（V2.5 p26）只画 HSI/HSE/PLLCLK÷2；寄存器 MCO[3:0] 0100=SYSCLK（d8）另有——图/寄存器差异并列；HAL 不生成"
    },
    {
      "id": "USBPRE",
      "kind": "readout",
      "group": "g-pll",
      "label": "USBPRE",
      "inputs": [{ "id": "PLL", "label": "PLLCLK" }],
      "fixedDivLabel": "auto ÷1/÷2/÷3",
      "note": "RM 图 3-3（V2.5 p26）：USB prescaler /1,/2,/3 自 PLLCLK 抽头、经 peripheral clock enable 门出 48MHz；HAL calc_usbpre 自动（48/96/144→÷1/÷2/÷3）；无 API 不生成"
    },
    {
      "id": "CORE",
      "kind": "readout",
      "label": "内核 / DMA / 存储器",
      "inputs": [{ "id": "AHB", "label": "HCLK" }],
      "deriveDiv": 1,
      "group": "g-out",
      "note": "MX2 To AHB bus,core,memory and DMA / To FCLK 对应行；RISC-V 内核=HCLK；仅显示不生成"
    },
    {
      "id": "SYSTICK",
      "kind": "readout",
      "label": "系统定时器 SysTick",
      "inputs": [{ "id": "AHB", "label": "HCLK" }],
      "deriveDiv": 1,
