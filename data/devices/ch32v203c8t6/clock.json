  "timerClock": "apb_x2",
  "timerLabels": ["TIM2–4", "TIM1"],
  "peripheralClocks": {
    "usart": {
      "sourceDefault": "APB1",
      "sourceOverrides": { "USART1": "APB2" },
      "knob": "baudrate"
    },
    "spi": {
      "sourceDefault": "APB1",
      "sourceOverrides": { "SPI1": "APB2" },
      "knob": "frequency",
