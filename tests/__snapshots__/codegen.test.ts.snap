target = "riscv32ec-unknown-none-elf.json"

[target."riscv32ec-unknown-none-elf"]
runner = "wlink -v flash --enable-sdi-print --watch-serial"

# 构建档位别名（profile 定义在 Cargo.toml 标记区内）
[alias]
build-size = "build --profile release-size"
