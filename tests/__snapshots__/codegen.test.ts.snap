  "src/generated/pins.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;
use hal::gpio::{Input, Level, Output, OutputOpenDrain, Pull, Speed};

/// 已配置的 GPIO 引脚集合（INPUT/OUTPUT 模式；AF/ANALOG 引脚归各外设模块管理）
pub struct Pins<'d> {
    /// PD6（输出，推挽，初始 Low，速度 Medium）
    pub app_led_run: Output<'d>,
    /// PC3（输出，开漏，初始 High，速度 High）
    pub app_bus_en: OutputOpenDrain<'d>,
    /// PC4（输入，上拉）
    pub app_key0: Input<'d>,
}

/// 逐引脚传入 hal::Peripherals 的引脚单例，返回 'static 借用期的引脚集合
pub fn init(pd6: hal::Peri<'static, hal::peripherals::PD6>, pc3: hal::Peri<'static, hal::peripherals::PC3>, pc4: hal::Peri<'static, hal::peripherals::PC4>) -> Pins<'static> {
    Pins {
        app_led_run: Output::new(pd6, Level::Low, Speed::Medium),
        app_bus_en: OutputOpenDrain::new(pc3, Level::High, Speed::High),
        app_key0: Input::new(pc4, Pull::Up),
    }
}
",
