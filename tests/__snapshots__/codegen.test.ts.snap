  "src/generated/clock.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
// SYSCLK=24MHz HCLK=24MHz PCLK1=24MHz PCLK2=24MHz

use ch32_hal as hal;

/// 时钟树推导出的 RCC 配置
pub fn rcc_config() -> hal::rcc::Config {
    // 无匹配预设：按 Config 字段显式构造（Config 为 non_exhaustive 思路一致：default 后逐字段赋值）
    let mut cfg = hal::rcc::Config::default();
    cfg.sys = hal::pac::rcc::vals::Sw::HSI;
    cfg.ahb_pre = hal::pac::rcc::vals::Hpre::DIV1;
    cfg.apb2_pre = hal::pac::rcc::vals::Ppre::DIV1;
    cfg
}
",
  "src/generated/mod.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

pub mod clock;
pub mod pins;

/// 全部生成模块的聚合对象：main.rs 只需要拿这一个值
pub struct Generated {
    pub pins: pins::Pins<'static>,
}

pub fn init(p: hal::Peripherals) -> Generated {
    Generated {
        pins: pins::init(p.PD6, p.PC3, p.PC4),
    }
}
