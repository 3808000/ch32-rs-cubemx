",
  "v3f/Cargo.toml": "# >>> ch32-cubemx generated >>>
# 由 ch32-rs-CubeMX 生成 —— 重新导出只更新标记区内内容（标记区外内容会保留）
[package]
name = "h417-demo-v3f"
version = "0.1.0"
edition = "2024"

[[bin]]
name = "h417-demo-v3f"
path = "src/main.rs"
harness = false

[dependencies]
ch32-hal = { workspace = true, features = ["ch32h417qeu6-v3f", "rt", "exti", "memory-x"] }
qingke-rt = { version = "0.8.4", features = ["highcode"] }
qingke = { version = "0.8.4", features = ["unsafe-trust-wch-atomics", "dual-core"] }
embedded-hal = "1.0.0"
panic-halt = "1.0.0"
# <<< ch32-cubemx generated <<<
",
  "v3f/build.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
// 启动核（V3F）：随 crate 提供 memory.x 与 link.x。
// memory.x 覆盖 metapac 的 memory-x 版本（其中没有 qingke-rt link.x 需要的 RAM 区）；
// link.x 覆盖 qingke-rt 的版本，让整个程序从零等待共享 SRAM 执行（hart0 无 I-cache）。
fn main() {
    println!("cargo:rustc-link-arg-bins=-Tlink.x");

    let out_dir = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
    std::fs::write(out_dir.join("memory.x"), include_bytes!("memory.x")).unwrap();
    std::fs::write(out_dir.join("link.x"), include_bytes!("link.x")).unwrap();
    println!("cargo:rustc-link-search={}", out_dir.display());
    println!("cargo:rerun-if-changed=memory.x");
    println!("cargo:rerun-if-changed=link.x");
}
",
  "v3f/link.x": "/*
 * V3F 启动核链接脚本：整个程序在零等待共享 SRAM 中运行。
 *
 * 取自 qingke-rt 的 link-highcode.x，唯一差异是 .text/.rodata 折进 .highcode：
 * hart0 没有指令 cache，从 Code FLASH 取指约 2.6 MIPS，而从共享 SRAM 执行约 1 IPC。
 * 留在 flash 的只有拷贝建立前就要运行的 .init 与 .handle_reset。
 */
INCLUDE memory.x
INCLUDE device.x

PROVIDE(_stext = ORIGIN(REGION_TEXT));
PROVIDE(_stack_start = ORIGIN(REGION_STACK) + LENGTH(REGION_STACK));
PROVIDE(_max_hart_id = 0);
PROVIDE(_hart_stack_size = 2K);
PROVIDE(_heap_size = 0);

/* 异常处理 */
PROVIDE(InstructionMisaligned = ExceptionHandler);
PROVIDE(InstructionFault = ExceptionHandler);
PROVIDE(IllegalInstruction = ExceptionHandler);
PROVIDE(Breakpoint = ExceptionHandler);
PROVIDE(LoadMisaligned = ExceptionHandler);
PROVIDE(LoadFault = ExceptionHandler);
PROVIDE(StoreMisaligned = ExceptionHandler);
PROVIDE(StoreFault = ExceptionHandler);
PROVIDE(UserEnvCall = ExceptionHandler);
PROVIDE(MachineEnvCall = ExceptionHandler);

/* 内核中断 */
PROVIDE(NonMaskableInt = DefaultHandler);
PROVIDE(SysTick = DefaultHandler);
PROVIDE(Software = DefaultHandler);

PROVIDE(Exception = _exception_handler);

PROVIDE(DefaultHandler = DefaultInterruptHandler);
PROVIDE(ExceptionHandler = DefaultExceptionHandler);

EXTERN(__CORE_INTERRUPTS);
EXTERN(__EXTERNAL_INTERRUPTS);

ENTRY(_start)

SECTIONS
{
    .init :
    {
        . = ALIGN(4);
        KEEP(*(SORT_NONE(.init)))
        . = ALIGN(4);
    } >FLASH AT>FLASH

    /* 启动时从 flash 拷到 RAM，之后在 RAM 执行 */
    .highcode : ALIGN(4)
    {
        _highcode_lma = LOADADDR(.highcode);
        PROVIDE(_highcode_vma_start = .);
        LONG(_start);
        KEEP(*(.vector_table.core_interrupts));
        KEEP(*(.vector_table.external_interrupts));
        KEEP(*(.vector_table.exceptions));
        *(.trap .trap.rust)
        *(.highcode);
        *(.highcode.*);
        *(.text .text.*)
        *(.gnu.linkonce.t.*)
        *(.rodata .rodata.*);
        *(.srodata .srodata.*);
        . = ALIGN(4);
        PROVIDE(_highcode_vma_end = .);
    } >RAM AT>FLASH

    /* 拷贝建立前运行的代码，留在 flash */
    .text : ALIGN(4)
    {
        . = ALIGN(4);
        KEEP(*(SORT_NONE(.handle_reset)))
        *(.init.rust)
    } >FLASH AT>FLASH

    .data : ALIGN(4)
    {
        _data_lma = LOADADDR(.data);
        PROVIDE(_data_vma = .);
        PROVIDE( __global_pointer$ = . + 0x800 );
        *(.sdata .sdata.* .sdata2 .sdata2.*);
        *(.data .data.*);
        . = ALIGN(4);
        PROVIDE( _edata = .);
    } >RAM AT>FLASH

    .bss (NOLOAD) : ALIGN(4)
    {
        PROVIDE( _sbss = .);
        *(.sbss .sbss.* .bss .bss.*);
        PROVIDE( _ebss = .);
    } >RAM

    .uninit (NOLOAD) : ALIGN(4)
    {
        *(.uninit .uninit.*);
    } >RAM

    . = ALIGN(4);

    PROVIDE(__sheap = .);
    PROVIDE(_stack_end = .);

    .got (INFO) :
    {
        KEEP(*(.got .got.*));
    }

    .eh_frame (INFO) : { KEEP(*(.eh_frame)) }
    .eh_frame_hdr (INFO) : { *(.eh_frame_hdr) }
}

INCLUDE assert-align.x
",
  "v3f/memory.x": "/*
 * CH32H417QEU6（QingKe V3F / 启动核）链接内存布局。
 *
 *   0x00000000 +  64K  V3F flash 加载槽
 *   0x00010000 + ...   V5F flash（单核模式下不使用）
 *   0x20100000 + 448K  零等待代码/数据/bss（V3F 经 highcode 从这里运行）
 *   0x20170000 +  32K  零等待栈
 *   0x20178000 +  32K  跨核邮箱区
 *
 * 覆盖 ch32-metapac 生成的 memory.x：后者没有 qingke-rt link.x 需要的 \`RAM\` 区。
 */
MEMORY
{
    CODE   (rx)  : ORIGIN = 0x00000000, LENGTH =  64K
    USR    (rwx) : ORIGIN = 0x08000000, LENGTH =  64K
    SYS    (rwx) : ORIGIN = 0x1FFF0000, LENGTH =   56K
    VND    (r)   : ORIGIN = 0x1FFFF700, LENGTH =   256
    OPT    (rw)  : ORIGIN = 0x1FFFF800, LENGTH =   256
    RAM    (rwx) : ORIGIN = 0x20100000, LENGTH = 448K
    STACK  (rwx) : ORIGIN = 0x20170000, LENGTH =  32K
    ITCM   (rwx) : ORIGIN = 0x200A0000, LENGTH = 128K
    SRAM_SHARED (rwx) : ORIGIN = 0x20178000, LENGTH = 32K
}

REGION_ALIAS("FLASH", CODE);
REGION_ALIAS("REGION_TEXT", CODE);
REGION_ALIAS("REGION_RODATA", CODE);
REGION_ALIAS("REGION_DATA", RAM);
REGION_ALIAS("REGION_BSS", RAM);
REGION_ALIAS("REGION_HEAP", RAM);
REGION_ALIAS("REGION_STACK", STACK);
",
  "v3f/riscv32imafc-unknown-none-elf.json": "{
  "abi": "ilp32f",
  "arch": "riscv32",
  "atomic-cas": true,
  "cpu": "generic-rv32",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+m,+a,+f,+c,+xwchc",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "ilp32f",
  "llvm-target": "riscv32",
  "max-atomic-width": 32,
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-pointer-width": 32
}
",
  "v3f/src/generated/adc.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// ADC1：ADC 通道是引脚的 trait 实现（非整数索引），每个使用的通道一个引脚字段
pub struct Adc1 {
    pub adc: hal::adc::Adc<'static, hal::peripherals::ADC1>,
    /// PA0（ADC_IN0）
    pub in0: hal::Peri<'static, hal::peripherals::PA0>,
}

pub fn init_adc1(adc_peri: hal::Peri<'static, hal::peripherals::ADC1>, pa0: hal::Peri<'static, hal::peripherals::PA0>) -> Adc1 {
    // H4/V4x7：Adc::new 返回 Result（时钟不可用/过快时失败）
    let adc = hal::adc::Adc::new(adc_peri, Default::default()).unwrap();
    Adc1 {
        adc,
        in0: pa0,
    }
}

// 读取示例（按需复制到用户代码区）：
// let v = g.adc1.adc.blocking_read(&mut g.adc1.in0, hal::adc::SampleTime::S71_5).unwrap();
",
  "v3f/src/generated/clock.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
// SYSCLK=400MHz HCLK=100MHz PCLK1=100MHz PCLK2=100MHz

use ch32_hal as hal;

/// 时钟树推导出的 RCC 配置
pub fn rcc_config() -> hal::rcc::Config {
    // 命中 HAL 预设常量：400MHz（HSI 25MHz×16，V5F 400MHz / V3F 100MHz）
    hal::rcc::Config::with_sysclk_400m_v5f_400m_v3f_100m_hsi()
}
",
  "v3f/src/generated/mod.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

