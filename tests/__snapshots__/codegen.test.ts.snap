/// 初始化 USART1（115200 8N1）
pub fn init_usart1(peri: hal::Peri<'static, hal::peripherals::USART1>, rx: hal::Peri<'static, hal::peripherals::PD6>, tx: hal::Peri<'static, hal::peripherals::PD5>) -> Usart1 {
