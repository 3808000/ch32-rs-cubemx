  "v3f/.cargo/config.toml": "# 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
[build]
target = "riscv32imafc-unknown-none-elf.json"

[unstable]
build-std = ["core"]
json-target-spec = true

[target."riscv32imafc-unknown-none-elf"]
