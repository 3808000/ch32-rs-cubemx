  "v3f/src/generated/usart.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// USART1 驱动类型（TX=PA9(AF7) RX=PA10(AF7)）
pub type Usart1 = hal::usart::Uart<'static, hal::peripherals::USART1, hal::mode::Blocking>;

/// 初始化 USART1（115200 8N1）
pub fn init_usart1(peri: hal::Peri<'static, hal::peripherals::USART1>, rx: hal::Peri<'static, hal::peripherals::PA10>, tx: hal::Peri<'static, hal::peripherals::PA9>) -> Usart1 {
    let mut cfg = hal::usart::Config::default();
    cfg.baudrate = 115200;
    cfg.data_bits = hal::usart::DataBits::DataBits8;
    cfg.stop_bits = hal::usart::StopBits::STOP1;
    cfg.parity = hal::usart::Parity::ParityNone;
    cfg.detect_previous_overrun = false;
    // 注意参数顺序：rx 在前、tx 在后；返回 Result，用 unwrap 解包
    hal::usart::Uart::new_blocking(peri, rx, tx, cfg).unwrap()
}
