  "src/generated/spi.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// SPI1 驱动类型（remap 0：SCK=PC5 MOSI=PC6 MISO=PC7）
pub type Spi1 = hal::spi::Spi<'static, hal::peripherals::SPI1, hal::mode::Blocking>;

/// 初始化 SPI1（模式 MODE_0（CPOL=0 CPHA=0），位序 MsbFirst，1_000_000Hz）
pub fn init_spi1(peri: hal::Peri<'static, hal::peripherals::SPI1>, sck: hal::Peri<'static, hal::peripherals::PC5>, mosi: hal::Peri<'static, hal::peripherals::PC6>, miso: hal::Peri<'static, hal::peripherals::PC7>) -> Spi1 {
    let mut cfg = hal::spi::Config::default();
    cfg.mode = embedded_hal::spi::MODE_0;
    cfg.bit_order = hal::spi::BitOrder::MsbFirst;
    cfg.frequency = hal::time::Hertz::hz(1_000_000);
    // 阻塞构造直接返回 Self（无 Result）
    hal::spi::Spi::new_blocking::<0>(peri, sck, mosi, miso, cfg)
}
",
