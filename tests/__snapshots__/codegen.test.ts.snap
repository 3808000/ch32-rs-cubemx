  "src/generated/i2c.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// I2C1 驱动类型（remap 0：SCL=PC2 SDA=PC1）
pub type I2c1 = hal::i2c::I2c<'static, hal::peripherals::I2C1, hal::mode::Async>;

/// 初始化 I2C1（速率 100_000Hz（Standard 模式），占空比 Duty2_1）
pub fn init_i2c1(peri: hal::Peri<'static, hal::peripherals::I2C1>, scl: hal::Peri<'static, hal::peripherals::PC2>, sda: hal::Peri<'static, hal::peripherals::PC1>, irqs: super::Irqs, tx_dma: hal::Peri<'static, hal::peripherals::DMA1_CH6>, rx_dma: hal::Peri<'static, hal::peripherals::DMA1_CH7>) -> I2c1 {
    let mut cfg = hal::i2c::Config::default();
    cfg.duty = hal::i2c::Duty::Duty2_1;
    // 异步需双中断绑定（I2C1_EV/I2C1_ER，见 super::Irqs）与 TX/RX DMA 通道
    hal::i2c::I2c::new::<0>(peri, scl, sda, irqs, tx_dma, rx_dma, hal::time::Hertz::hz(100_000), cfg)
}
",
  "src/generated/mod.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

pub mod clock;
pub mod pins;
pub mod usart;
pub mod i2c;

// embassy 中断绑定（异步 USART/I2C 构造需要）
hal::bind_interrupts! {
    struct Irqs {
        USART1 => hal::usart::InterruptHandler<hal::peripherals::USART1>;
        I2C1_EV => hal::i2c::EventInterruptHandler<hal::peripherals::I2C1>;
        I2C1_ER => hal::i2c::ErrorInterruptHandler<hal::peripherals::I2C1>;
    }
}

/// 全部生成模块的聚合对象：main.rs 只需要拿这一个值
pub struct Generated {
    pub pins: pins::Pins,
    pub usart1: usart::Usart1,
    pub i2c1: i2c::I2c1,
}

pub fn init(p: hal::Peripherals) -> Generated {
    Generated {
        pins: pins::init(),
        usart1: usart::init_usart1(p.USART1, p.PD6, p.PD5, Irqs, p.DMA1_CH4, p.DMA1_CH5),
        i2c1: i2c::init_i2c1(p.I2C1, p.PC2, p.PC1, Irqs, p.DMA1_CH6, p.DMA1_CH7),
    }
}
",
