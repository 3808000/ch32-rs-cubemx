/// 初始化 USART1（115200 8N1）
pub fn init_usart1(peri: hal::Peri<'static, hal::peripherals::USART1>, rx: hal::Peri<'static, hal::peripherals::PD6>, tx: hal::Peri<'static, hal::peripherals::PD5>, irqs: super::Irqs, tx_dma: hal::Peri<'static, hal::peripherals::DMA1_CH4>, rx_dma: hal::Peri<'static, hal::peripherals::DMA1_CH5>) -> Usart1 {
