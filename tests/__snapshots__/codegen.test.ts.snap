use ch32_hal as hal;

/// I2C1 驱动类型（remap 0：SCL=PC2 SDA=PC1）
pub type I2c1 = hal::i2c::I2c<'static, hal::peripherals::I2C1, hal::mode::Blocking>;

/// 初始化 I2C1（速率 100_000Hz（Standard 模式），占空比 Duty2_1）
pub fn init_i2c1(peri: hal::Peri<'static, hal::peripherals::I2C1>, scl: hal::Peri<'static, hal::peripherals::PC2>, sda: hal::Peri<'static, hal::peripherals::PC1>) -> I2c1 {
    let mut cfg = hal::i2c::Config::default();
    cfg.duty = hal::i2c::Duty::Duty2_1;
    // 阻塞构造直接返回 Self（无 Result）
    hal::i2c::I2c::new_blocking::<0>(peri, scl, sda, hal::time::Hertz::hz(100_000), cfg)
}
