  "src/generated/adc.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// ADC1：ADC 通道是引脚的 trait 实现（非整数索引），每个使用的通道一个引脚字段
pub struct Adc1 {
    pub adc: hal::adc::Adc<'static, hal::peripherals::ADC1>,
    /// PA1（ADC_IN1）
    pub in1: hal::Peri<'static, hal::peripherals::PA1>,
    /// PA2（ADC_IN0）
    pub in0: hal::Peri<'static, hal::peripherals::PA2>,
}

pub fn init_adc1(adc_peri: hal::Peri<'static, hal::peripherals::ADC1>, pa1: hal::Peri<'static, hal::peripherals::PA1>, pa2: hal::Peri<'static, hal::peripherals::PA2>) -> Adc1 {
    let adc = hal::adc::Adc::new(adc_peri, Default::default());
    Adc1 {
        adc,
        in1: pa1,
        in0: pa2,
    }
}

// 读取示例（按需复制到用户代码区）：
// let v = g.adc1.adc.convert(&mut g.adc1.in1, hal::adc::SampleTime::CYCLES73);
