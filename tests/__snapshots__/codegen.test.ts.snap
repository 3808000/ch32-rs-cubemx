#![no_main]

use {ch32_hal as hal, panic_halt as _};

mod generated;

#[qingke_rt::entry]
fn main() -> ! {
    hal::debug::SDIPrint::enable();
    let mut config = hal::Config::default();
    config.rcc = generated::clock::rcc_config();
    let p = hal::init(config);

    // —— 用户代码区（生成器永不覆盖本文件）——
    let g = generated::init(p);
    let _ = &g;
    loop {
        // TODO: 你的逻辑
    }
}
",
}
`;

