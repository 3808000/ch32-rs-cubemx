  "src/generated/clock.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
// SYSCLK=24MHz HCLK=24MHz PCLK1=24MHz PCLK2=24MHz

use ch32_hal as hal;

/// 时钟树推导出的 RCC 配置
pub fn rcc_config() -> hal::rcc::Config {
    // 无匹配预设：按 Config 字段显式构造（Config 为 non_exhaustive 思路一致：default 后逐字段赋值）
    let mut cfg = hal::rcc::Config::default();
    cfg.sys = hal::pac::rcc::vals::Sw::HSI;
    cfg.ahb_pre = hal::pac::rcc::vals::Hpre::DIV1;
    cfg.apb2_pre = hal::pac::rcc::vals::Ppre::DIV1;
    cfg
}
",
  "src/generated/exti.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

/// EXTI 输入集合。
/// 注意：边沿不在构造函数里，由 wait_for_* 系列 async 方法在运行期设置（需 embassy）。
pub struct Exti {
    // 边沿: FALLING（wait_for_falling_edge 时生效）
    pub btn: hal::exti::ExtiInput<'static>,
    // 边沿: RISING（wait_for_rising_edge 时生效）
    pub pd3: hal::exti::ExtiInput<'static>,
}

pub fn init(pc1: hal::Peri<'static, hal::peripherals::PC1>, exti1: hal::Peri<'static, hal::peripherals::EXTI1>, pd3: hal::Peri<'static, hal::peripherals::PD3>, exti3: hal::Peri<'static, hal::peripherals::EXTI3>) -> Exti {
    Exti {
        btn: hal::exti::ExtiInput::new(pc1, exti1, hal::gpio::Pull::Down),
        pd3: hal::exti::ExtiInput::new(pd3, exti3, hal::gpio::Pull::Up),
    }
}
",
  "src/generated/mod.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

pub mod clock;
pub mod pins;
pub mod exti;

/// 全部生成模块的聚合对象：main.rs 只需要拿这一个值
pub struct Generated {
    pub pins: pins::Pins,
    pub exti: exti::Exti,
}

pub fn init(p: hal::Peripherals) -> Generated {
    Generated {
        pins: pins::init(),
        exti: exti::init(p.PC1, p.EXTI1, p.PD3, p.EXTI3),
    }
}
",
