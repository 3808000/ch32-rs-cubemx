  "src/generated/clock.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件
// SYSCLK=48MHz HCLK=48MHz PCLK1=48MHz PCLK2=48MHz

use ch32_hal as hal;

/// 时钟树推导出的 RCC 配置
pub fn rcc_config() -> hal::rcc::Config {
    // 命中 HAL 预设常量：48MHz (HSE 24MHz×2)
    hal::rcc::Config::SYSCLK_FREQ_48MHZ_HSE
}
",
  "src/generated/mod.rs": "// 由 ch32-rs-CubeMX 生成 —— 重新导出会覆盖本文件

use ch32_hal as hal;

pub mod clock;
pub mod pins;

/// 全部生成模块的聚合对象：main.rs 只需要拿这一个值
pub struct Generated {
    pub pins: pins::Pins,
}

pub fn init(p: hal::Peripherals) -> Generated {
    Generated {
        pins: pins::init(),
    }
}
